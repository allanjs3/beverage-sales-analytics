{
  "name": "agg_sales_region_brand",
  "target": "workspace.beverage_sales_gold.agg_sales_region_brand",
  "description": "Total monetary sales for observed region and brand combinations.",
  "columns": [
    {
      "name": "region_name",
      "type": "string",
      "description": "Geographic sales region."
    },
    {
      "name": "brand_name",
      "type": "string",
      "description": "Name of the beverage brand."
    },
    {
      "name": "sales_amount",
      "type": "decimal(38,2)",
      "description": "Monetary sales amount, including negative and zero values; currency is unspecified."
    }
  ],
  "kind": "summary",
  "depends_on": [
    "fact_sales",
    "dim_region",
    "dim_product"
  ],
  "source_name": "fact_sales",
  "quality": {
    "aggregate_group_key_valid": {
      "type": "unique",
      "columns": [
        "region_name",
        "brand_name"
      ],
      "description": "Checks that region_name, brand_name form a complete, unique group key."
    },
    "aggregate_totals_match_fact": {
      "type": "aggregate",
      "source": "gold/fact_sales",
      "joins": [
        {
          "table": "gold/dim_region",
          "columns": [
            "region_key"
          ]
        },
        {
          "table": "gold/dim_product",
          "columns": [
            "product_key"
          ]
        }
      ],
      "group_by": [
        "region_name",
        "brand_name"
      ],
      "measure": "sales_amount",
      "description": "Checks that sales totals by region_name, brand_name match the sales fact."
    }
  }
}
